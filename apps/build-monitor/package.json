{
  "name": "@docker-image-builder-system/build-monitor",
  "version": "0.8.7",
  "private": true,
  "type": "module",
  "description": "React 19 (Astryx) + Vite + TypeScript frontend for the Docker Image Builder Build Server Monitor. TASK-101 — Svelte scaffold 일괄 정리, React primary SPA 단일화.",
  "scripts": {
    "dev": "vite",
    "dev:react": "vite",
    "build": "vite build",
    "build:react": "vite build",
    "preview": "vite preview --port 4173",
    "check": "tsc --noEmit -p tsconfig.react.json",
    "check:react": "tsc --noEmit -p tsconfig.react.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:theme-contrast": "node scripts/check-theme-contrast.mjs",
    "check:css-leak": "node scripts/check-css-leak.mjs",
    "predev": "tsx scripts/generate-openapi.ts",
    "prebuild": "tsx scripts/generate-openapi.ts",
    "generate:openapi": "tsx scripts/generate-openapi.ts"
  },
  "devDependencies": {
    "@docker-image-builder-system/shared-contract": "workspace:*",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.4.4",
    "playwright": "^1.61.1",
    "playwright-core": "^1.61.1",
    "tslib": "^2.7.0",
    "tsx": "^4.20.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.1.7",
    "@astryxdesign/theme-neutral": "^0.1.7",
    "@stylexjs/stylex": "^0.19.0",
    "openapi-fetch": "^0.13.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.1",
    "zustand": "^5.0.2"
  }
}
